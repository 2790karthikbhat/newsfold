<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Newsfold{% endblock %}</title>
  <style>
    /*
      Paper & Ink design tokens (docs/paper-and-ink-design-spec.md). Warm paper,
      never pure black/white; tone-shift for elevation, not shadows; one ribbon
      accent + one quiet secondary — no per-topic color wheel.
    */
    :root {
      color-scheme: light dark;
      --bg: #F5F0E6; --ink: #211D18; --muted: #6B6250; --line: #e0d6bf;
      --surface: #EDE6D6; --ribbon: #A8402E; --ribbon-soft: rgba(168,64,46,.12);
      --ok: #4c7a3f; --danger: #a8402e;
      --sans: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", system-ui, sans-serif;
      --serif: ui-serif, "New York", Georgia, Cambria, "Times New Roman", Times, serif;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #2A241D; --ink: #EFE7D6; --muted: #9C8F73; --line: #453c2d;
        --surface: #332C22; --ribbon: #C96A4F; --ribbon-soft: rgba(201,106,79,.16);
        --ok: #86b374; --danger: #d98a72;
      }
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; }
    body { background: var(--bg); color: var(--ink); font: 15px/1.55 var(--sans);
           display: flex; min-height: 100vh; }

    aside { width: 15rem; flex-shrink: 0; background: var(--surface);
            border-right: 1px solid var(--line); padding: 1.5rem 1rem;
            position: sticky; top: 0; height: 100vh; overflow-y: auto; }
    .brand { font-family: var(--serif); font-size: 1.25rem; font-weight: 600;
             margin: 0 0 1.5rem .4rem; letter-spacing: -.01em; }
    .brand em { font-style: normal; color: var(--ribbon); }
    nav.side { display: flex; flex-direction: column; gap: .15rem; }
    nav.side a { display: flex; align-items: center; gap: .6rem; padding: .55rem .7rem;
                 border-radius: .4rem; color: var(--ink); text-decoration: none;
                 font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; }
    nav.side a:hover { background: var(--bg); }
    nav.side a.current { background: var(--bg); font-weight: 600; color: var(--ribbon); }
    nav.side .dot { width: .4rem; height: .4rem; border-radius: 50%; background: var(--muted); flex-shrink: 0; }
    nav.side a.current .dot { background: var(--ribbon); }

    main { flex: 1; min-width: 0; padding: 2.25rem 2.5rem 5rem; max-width: 56rem; margin: 0 auto; }
    h1.page-title { font-family: var(--serif); font-size: 1.7rem; margin: 0 0 .3rem; letter-spacing: -.005em; }
    .page-sub { color: var(--muted); font-size: .88rem; margin: 0 0 1.8rem; }
    .eyebrow { font-size: .72rem; text-transform: uppercase; letter-spacing: .09em; color: var(--muted);
               font-weight: 600; margin: 0 0 .6rem; }

    .flash { padding: .55rem .9rem; border-radius: .4rem; margin-bottom: 1.4rem; font-size: .85rem;
             border: 1px solid var(--line); }
    .flash.msg { color: var(--ok); }
    .flash.error { color: var(--danger); }

    /* Cards: tone-shift from the page background, no drop shadows. A ribbon
       accent (a thin strip with a notched tail, like a cloth bookmark) marks
       reading content specifically — topic/article cards, not utility chrome. */
    .card { position: relative; background: var(--surface); border: 1px solid var(--line);
            border-radius: .45rem; padding: 1.1rem 1.3rem; }
    .card.ribbon { padding-left: 1.55rem; }
    .card.ribbon::before { content: ""; position: absolute; left: 0; top: 0;
                            width: 4px; height: calc(100% - 9px); background: var(--ribbon); }
    .card.ribbon::after { content: ""; position: absolute; left: 0; top: calc(100% - 9px);
                           width: 4px; height: 9px; background: var(--ribbon);
                           clip-path: polygon(0 0, 100% 0, 50% 100%); }
    a.card { display: block; text-decoration: none; color: inherit; transition: background-color .18s ease; }
    a.card:hover { background: var(--bg); }
    .grid { display: grid; gap: .8rem; }
    .grid.cols-2 { grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
    .stack { display: flex; flex-direction: column; gap: .7rem; }
    .rail { display: flex; gap: .8rem; overflow-x: auto; padding-bottom: .3rem; }
    .rail .card { flex: 0 0 16rem; }

    .badge { display: inline-block; font-size: .68rem; text-transform: uppercase;
             letter-spacing: .05em; border: 1px solid var(--line); border-radius: .35rem;
             padding: .1rem .45rem; color: var(--muted); }
    .badge.active { color: var(--ok); border-color: var(--ok); }
    .badge.archived, .badge.broken { color: var(--danger); border-color: var(--danger); }
    .badge.count { color: var(--ribbon); border-color: var(--ribbon); background: var(--ribbon-soft); }

    .meta { color: var(--muted); font-size: .8rem; }
    .meta a { color: var(--muted); }
    .ledger { font-size: .82rem; color: var(--muted); margin: 0 0 1.8rem; }
    .ledger strong { color: var(--ink); font-weight: 600; }

    details.panel { margin-top: 1.6rem; }
    details.panel summary { cursor: pointer; font-size: .78rem; font-weight: 600; color: var(--ribbon);
                             list-style: none; padding: .3rem 0; text-transform: uppercase; letter-spacing: .06em; }
    details.panel summary::-webkit-details-marker { display: none; }
    details.panel summary::before { content: "+ "; }
    details.panel[open] summary::before { content: "\2212 "; }
    details.panel .card { margin-top: .7rem; }

    label { display: block; font-size: .74rem; text-transform: uppercase; letter-spacing: .05em;
            color: var(--muted); margin: .8rem 0 .3rem; }
    input, select { width: 100%; padding: .45rem .55rem; font-size: .92rem; border: 1px solid var(--line);
                    border-radius: .35rem; background: var(--bg); color: var(--ink); font-family: var(--sans); }
    button { margin-top: 1rem; padding: .5rem 1rem; font-size: .78rem; font-weight: 600; border: none;
             text-transform: uppercase; letter-spacing: .05em;
             border-radius: .35rem; background: var(--ribbon); color: var(--bg); cursor: pointer;
             transition: opacity .15s ease; }
    button:hover { opacity: .88; }
    button.ghost { margin-top: 0; padding: .25rem .55rem; font-size: .68rem; font-weight: 600;
                   background: transparent; border: 1px solid var(--danger); color: var(--danger); }
    form.inline { display: inline; }

    /* Quiet reader-state actions (read/archive/save toggles) — reversible, so
       neutral-toned, unlike .ghost (reserved for the one destructive action). */
    .actions { display: flex; gap: .5rem; margin: .9rem 0; flex-wrap: wrap; }
    .actions form { margin: 0; }
    button.chip { margin-top: 0; padding: .3rem .6rem; font-size: .68rem; font-weight: 600;
                  background: transparent; border: 1px solid var(--line); color: var(--muted);
                  border-radius: .35rem; cursor: pointer; text-transform: uppercase; letter-spacing: .05em;
                  transition: border-color .15s ease, color .15s ease; }
    button.chip:hover { border-color: var(--ribbon); color: var(--ribbon); }
    button.chip.active { border-color: var(--ribbon); color: var(--ribbon); background: var(--ribbon-soft); }

    table.plain { width: 100%; border-collapse: collapse; }
    table.plain th, table.plain td { text-align: left; padding: .5rem .3rem; border-bottom: 1px solid var(--line);
                                      font-size: .86rem; }
    table.plain th { color: var(--muted); font-weight: 600; font-size: .72rem; text-transform: uppercase;
                      letter-spacing: .05em; }

    a { color: var(--ribbon); }
    .empty { color: var(--muted); font-size: .88rem; padding: 1rem 0; }

    @media (max-width: 700px) {
      body { flex-direction: column; }
      aside { width: 100%; height: auto; position: static; border-right: none; border-bottom: 1px solid var(--line);
              padding: 1rem; }
      nav.side { flex-direction: row; flex-wrap: wrap; }
      main { padding: 1.5rem 1.1rem 3rem; }
    }
  </style>
</head>
<body>
  <aside>
    <div class="brand">News<em>fold</em></div>
    <nav class="side">
      <a href="/" class="{{ 'current' if active == 'home' else '' }}"><span class="dot"></span>Home</a>
      <a href="/digest" class="{{ 'current' if active == 'digest' else '' }}"><span class="dot"></span>Digest</a>
      <a href="/digest/saved" class="{{ 'current' if active == 'saved' else '' }}"><span class="dot"></span>Saved</a>
      <a href="/topics" class="{{ 'current' if active == 'topics' else '' }}"><span class="dot"></span>Topics</a>
      <a href="/sources" class="{{ 'current' if active == 'sources' else '' }}"><span class="dot"></span>Sources</a>
    </nav>
  </aside>
  <main>
    {% if msg %}<div class="flash msg">{{ msg }}</div>{% endif %}
    {% if error %}<div class="flash error">{{ error }}</div>{% endif %}
    {% block content %}{% endblock %}
  </main>
</body>
</html>
