# Copy to .env — never commit the real file. Read from the repo root in a source
# checkout, and from your config dir (~/.config/newsfold/.env) when installed.

# LLM keys — only the one matching config/settings.yaml [llm].provider is needed.
# Local providers (lmstudio, ollama) need no key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21   # or v1 for the versionless /openai/v1 API

# Sports widget keys (config/settings.yaml [sports]) — `digest sports fetch`.
# F1 (Jolpica-F1) needs no key. Free-tier signup:
#   football: https://www.football-data.org/client/register
#   cricket:  https://bigballsdata.com (key looks like "bbs_live_...")
NEWSFOLD_SPORTS_FOOTBALL_API_KEY=
NEWSFOLD_SPORTS_CRICKET_API_KEY=

# --- Optional overrides ---
# Every var below has a default already in config/settings.yaml (as `${VAR:-default}`)
# — set one here only to change it without editing that tracked file. Comment out /
# leave blank to fall back to the file's default.

# NEWSFOLD_HOME=                       # data/ + out/ (+ config/) root; default: repo root
                                         # in a checkout, ~/.local/share/newsfold installed
# NEWSFOLD_CONFIG_DIR=                 # YAML config dir; default: <home>/config in a
                                         # checkout, ~/.config/newsfold installed
# NEWSFOLD_DB_URL=sqlite:///data/newsfold.db   # relative paths resolve against the home

# NEWSFOLD_DECODE_CONCURRENCY=3         # concurrent Google News decode workers (1 = serial)
# NEWSFOLD_EXTRACT_CONCURRENCY=5        # concurrent full-text fetch workers (1 = serial)

# NEWSFOLD_AUTO_ARCHIVE_DAYS=14         # unread articles older than this auto-archive
# NEWSFOLD_AUTO_DELETE_DAYS=30          # discarded/broken rows older than this get purged

# NEWSFOLD_PUBLIC_BASE_URL=             # how your BROWSER reaches `digest serve` —
                                           # set this if Glance runs in Docker (needed for
                                           # /glance/digest's article links to work)

# NEWSFOLD_LLM_PROVIDER=lmstudio        # anthropic | openai | azure | lmstudio | ollama
# NEWSFOLD_LLM_MODEL=                   # model (azure: deployment name) for the active provider
# NEWSFOLD_LLM_RANK_MODEL=              # optional: separate model for the ranking pass
# NEWSFOLD_LLM_BASE_URL=                # openai / azure (endpoint) / lmstudio / ollama
# NEWSFOLD_LLM_JSON_FORMAT=             # json_object | text — response_format mode
